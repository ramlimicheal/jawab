generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  language      String    @default("en")
  timezone      String    @default("Asia/Dubai")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  chatbots      Chatbot[]
  teamMembers   TeamMember[]
  subscription  Subscription?
  apiKeys       ApiKey[]
  organizations Organization[] @relation("OrgOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Chatbot {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String?
  name            String
  description     String?
  language        String   @default("ar")
  welcomeMessage  String   @default("أهلاً! كيف يمكنني مساعدتك؟ / Hello! How can I help you?")
  systemPrompt    String?  @db.Text
  temperature     Float    @default(0.7)
  modelName       String   @default("gpt-4.1")
  brandColor      String   @default("#059669")
  textColor       String   @default("#ffffff")
  logoUrl         String?
  botName         String   @default("Jawab")
  position        String   @default("bottom-right")
  isActive        Boolean  @default(true)
  widgetCode      String?  @db.Text
  // White-label branding
  customDomain    String?
  brandingJson    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  contents        Content[]
  threads         Thread[]
  leads           Lead[]
  qaOverrides     QAOverride[]
  personas        Persona[]
  teamMembers     TeamMember[]
  webhooks        Webhook[]
  ingestJobs      IngestJob[]

  @@index([userId])
  @@index([organizationId])
}

model Content {
  id          String      @id @default(cuid())
  chatbotId   String
  type        ContentType
  sourceUrl   String?
  fileName    String?
  fileSize    Int?
  title       String?
  textContent String?     @db.Text
  status      ContentStatus @default(PENDING)
  chunkCount  Int         @default(0)
  lastSynced  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  chatbot     Chatbot     @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chunks      ContentChunk[]

  @@index([chatbotId])
}

enum ContentType {
  WEBSITE
  PDF
  DOCX
  TXT
  CSV
  YOUTUBE
  MANUAL
}

enum ContentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model ContentChunk {
  id          String   @id @default(cuid())
  contentId   String
  text        String   @db.Text
  embedding   String?  @db.Text
  // pgvector column — enable with: CREATE EXTENSION IF NOT EXISTS vector; Backfill via scripts/backfill-vectors.ts
  // When pgvector is available, embeddingVec is used for DB-side ANN search (<=>). Falls back to JS cosine otherwise.
  embeddingVec Unsupported("vector(1536)")?
  tokenCount  Int      @default(0)
  chunkIndex  Int      @default(0)
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model Thread {
  id          String   @id @default(cuid())
  chatbotId   String
  visitorId   String
  visitorName String?
  visitorEmail String?
  visitorPhone String?
  status      ThreadStatus @default(OPEN)
  channel     Channel      @default(WIDGET)
  language    String   @default("ar")
  // Omnichannel + handoff
  isHandedOff Boolean  @default(false)
  handedOffAt DateTime?
  assignedTo  String?
  leadScore   Int      @default(0)
  leadScoreLabel String? // HOT | WARM | COLD
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbot     Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([chatbotId])
  @@index([visitorId])
  @@index([channel])
}

enum Channel {
  WIDGET
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  API
}

enum ThreadStatus {
  OPEN
  ESCALATED
  RESOLVED
  CLOSED
}

model Message {
  id          String      @id @default(cuid())
  threadId    String
  role        MessageRole
  content     String      @db.Text
  language    String?
  feedback    MessageFeedback?
  tokenCount  Int         @default(0)
  // Voice
  audioUrl    String?
  transcription String?   @db.Text
  createdAt   DateTime    @default(now())

  thread      Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageFeedback {
  POSITIVE
  NEGATIVE
}

model Lead {
  id          String   @id @default(cuid())
  chatbotId   String
  threadId    String?
  name        String?
  email       String?
  phone       String?
  whatsapp    String?
  message     String?  @db.Text
  source      String?
  status      LeadStatus @default(NEW)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbot     Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@index([chatbotId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model QAOverride {
  id          String   @id @default(cuid())
  chatbotId   String
  questionAr  String   @db.Text
  questionEn  String   @db.Text
  answerAr    String   @db.Text
  answerEn    String   @db.Text
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbot     Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@index([chatbotId])
}

model Persona {
  id          String   @id @default(cuid())
  chatbotId   String
  name        String
  nameAr      String?
  tone        String   @default("professional")
  systemPrompt String? @db.Text
  temperature Float    @default(0.7)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbot     Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@index([chatbotId])
}

model TeamMember {
  id          String     @id @default(cuid())
  userId      String
  chatbotId   String
  role        TeamRole   @default(MEMBER)
  inviteEmail String?
  inviteToken String?    @unique
  accepted    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatbot     Chatbot    @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@unique([userId, chatbotId])
  @@index([chatbotId])
}

enum TeamRole {
  ADMIN
  MEMBER
  VIEWER
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  stripeCustomerId  String?  @unique
  stripeSubId       String?  @unique
  plan              PlanType @default(FREE)
  status            SubStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlanType {
  FREE
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// ── Phase 1: Public API + Webhooks ──
model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Default")
  prefix    String   // first 8 of key for display
  hash      String   @unique // sha256 of full key
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Webhook {
  id        String   @id @default(cuid())
  chatbotId String
  url       String
  secret    String
  events    String   @default("lead.captured") // comma-separated: lead.captured,conversation.created,message.created
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  @@index([chatbotId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    String   @db.Text
  status     String   @default("PENDING") // PENDING | SUCCESS | FAILED | RETRYING
  attempts   Int      @default(0)
  nextRetryAt DateTime?
  lastError  String?  @db.Text
  createdAt  DateTime @default(now())
  @@index([webhookId])
  @@index([status])
}

// ── Phase 1: Background jobs ──
model IngestJob {
  id        String   @id @default(cuid())
  chatbotId String
  contentId String?
  type      String   // SCRAPE | PDF | DOCX | MANUAL | REINDEX
  status    String   @default("PENDING") // PENDING | PROCESSING | READY | FAILED
  payload   String?  @db.Text // JSON
  error     String?  @db.Text
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  @@index([chatbotId])
  @@index([status])
}

// ── Phase 3: White-label + analytics ──
model Organization {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  slug      String   @unique
  logoUrl   String?
  domain    String?  @unique
  brandingJson String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  chatbots  Chatbot[]
  @@index([ownerId])
}

model PersonaTemplate {
  id           String @id @default(cuid())
  key          String @unique // dental-clinic, real-estate, ecommerce
  name         String
  nameAr       String?
  description  String? @db.Text
  systemPrompt String  @db.Text
  tone         String  @default("professional")
  welcomeMessage String? @db.Text
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
}

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  chatbotId String
  date      DateTime @db.Date
  threads   Int      @default(0)
  leads     Int      @default(0)
  messages  Int      @default(0)
  topQuestions String? @db.Text // JSON array
  createdAt DateTime @default(now())
  @@unique([chatbotId, date])
  @@index([chatbotId])
}
